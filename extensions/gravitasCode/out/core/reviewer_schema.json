{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ReviewerOutput",
    "type": "object",
    "properties": {
        "status": {
            "type": "string",
            "enum": [
                "approve",
                "revise",
                "reject"
            ]
        },
        "issues": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "correctness",
                            "security",
                            "architecture",
                            "performance"
                        ]
                    },
                    "file": {
                        "type": "string"
                    },
                    "line": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "type",
                    "file",
                    "line",
                    "message"
                ]
            }
        },
        "required_changes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string"
                    },
                    "instruction": {
                        "type": "string"
                    }
                },
                "required": [
                    "file",
                    "instruction"
                ]
            }
        }
    },
    "required": [
        "status",
        "issues",
        "required_changes"
    ]
}
